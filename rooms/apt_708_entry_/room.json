    "#ff8800": {
      "id": "flag",
      "label": "Flag",
      "voice": "flag",
      "text": "A Chilean flag, pinned up like proof somebody here still believed in places. Romeo looks at it longer than he means to."
    },
    "#0000ff": {
      "id": "bed",
      "label": "Bed",
      "voice": "bed",
      "text": "The sheets smell like cold sweat and cheap detergent. Somebody slept badly here."
    },
    "#ffff00": {
      "id": "coffee_table",
      "label": "Table",
      "voice": "table",
      "text": "A battlefield of mugs, paper, and things nobody wanted to throw away."
    },
    "#ff00ff": {
      "id": "window",
      "label": "Window",
      "voice": "window",
      "text": "Snow crawls down the glass. Outside has the decency to stay outside."
    },
    "#00ffff": {
      "id": "tv",
      "label": "Television",
      "voice": "television",
      "text": "Dead screen. Heavy glass. The kind of silence that used to mean late-night movies."
    },
    "#380f04": {
      "id": "lamp",
      "label": "Lamp",
      "voice": "lamp",
      "text": "Camera on, camera off"
    },
    "#808080": {
      "id": "punchingbag",
      "label": "Punchingbag",
      "voice": "punchy",
      "text": "Judging by the dents, somebody was training for the end of the world."
    },
    "#ffffff": {
      "id": "books",
      "label": "Books",
      "voice": "books",
      "text": "Apparently the chosen one only needed friendship, courage, and a legendary blade."
    },
    "#955746": {
      "id": "jacket",
      "label": "Jacket",
      "voice": "jacket",
      "text": "It's my jacket, but after all of this, it feels like its not mine anymore."
    },
    "#042d0e": {
      "id": "picture",
      "label": "Picture",
      "voice": "picture",
      "text": "I look so young, a different life, was I ever happy, I wonder if I have ever been"
    },
    "#26863d": {
      "id": "vhs",
      "label": "VHS",
      "voice": "vhs",
      "text": "These VHS tapes might survive longer than me."
    },
    "#161d47": {
      "id": "pictures",
      "label": "Pictures",
      "voice": "pictures",
      "text": "Pictures of Tina and me, we used to be so happy. Or so it seemed."
    },
    "#2d3c9e": {
      "id": "heater",
      "label": "Heater",
      "voice": "heater",
      "text": "Atleast something heats up this place"

  "interests": {
    "#0000ff": {
      "id": "stairs",
      "label": "Stairs",
      "cursor": "exit",
      "targetRoom": "old_kitchen",
      "targetSpawn": "from_basement",
      "text": "The stairwell climbs back toward the kitchen. The dark below does not complain when Romeo leaves."

    "#00ff00": {
      "id": "storage_shelves",
      "label": "Shelves",
      "once": "basement_storage.shelves.screwdriver",
      "giveItem": "screwdriver",
      "text": "A flathead screwdriver slides from behind a row of dead paint cans. Small miracle, cheap handle.",
      "repeatText": "Rows of jars, tins, and forgotten supplies. The useful thing is already in Romeo's pocket."
    },
    "#00ffff": {
      "id": "utility_sink",
      "label": "Sink",
      "text": "A stained utility sink squats under the pipes. Whatever dried in it did not go quietly."
    },
    "#ff8800": {
      "id": "crate",
      "label": "Crate",
      "once": "basement_storage.crate.shells",
      "giveItem": "shotgun_shells",
      "raiseNoise": 12,
      "setFlag": "made_basement_noise",
      "text": "The crate complains loudly. Inside: two shotgun shells. A generous apocalypse would have left more.",
      "repeatText": "Just splinters and dust now."
    },
    "#ffff00": {
      "id": "breaker_box",
      "label": "Breaker Box",
      "once": "basement_storage.breaker_box.fuse",
      "giveItem": "fuse",
      "setFlag": "found_fuse",
      "raiseNoise": 8,
      "text": "Behind the cracked panel, Romeo finds a fuse that somehow survived the building better than the people did.",
      "repeatText": "The breaker box is empty now. Its switches stare back like bad teeth."
    },
    "#808080": {
      "id": "small_chest",
      "label": "Chest",
      "text": "A small chest waits on the floor, too neat for this room and therefore suspicious."
    },
    "#ff00ff": {
      "id": "brooms",
      "label": "Brooms",
      "text": "A broom and mop lean together like exhausted witnesses."

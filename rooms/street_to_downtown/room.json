      "rect": [0, 705, 190, 236],
      "targetRoom": "street",
      "targetSpawn": "from_downtown",
      "text": "I head back toward the garage street. Bad idea, but at least it is a known bad idea."
    },
    {
      "id": "lit_side_door",
      "label": "Lit Side Door",
      "rect": [575, 430, 220, 295],
      "targetRoom": "old_kitchen",
      "targetSpawn": "from_hallway",
      "text": "The door opens inward with that tired apartment-building sigh. I step inside before the street changes its mind."
    }
  ],
  "hotspots": [
    {
      "id": "downtown_street",
      "label": "Further Downtown",
      "rect": [780, 420, 355, 275],
      "targetRoom": "downtown_swarm",
      "targetSpawn": "from_parked_car",
      "text": "The block bends forward. More windows. Less mercy."
    },
    {
      "id": "lit_side_door_hotspot",
      "label": "Lit Side Door",
      "rect": [575, 430, 220, 295],
      "targetRoom": "old_kitchen",
      "targetSpawn": "from_hallway",
      "text": "I try the lit side door. It gives, which is almost more suspicious than if it stayed shut."
    }
  ],
  "onEnter": [
    {
      "once": "street_to_downtown.first_enter",
      "text": "The next block is quieter than the last. Quiet is not peace. Quiet is the street holding its breath."
    }
  ],
  "interests": {
    "#ff00ff": {
      "id": "dead_shutter",
      "label": "Dead Shutter",
      "text": "The shutter is pulled down like an eyelid. Whatever is behind it can keep its secrets."
    },
    "#ff0000": {
      "id": "left_service_door",
      "label": "Service Door",
      "targetRoom": "old_kitchen",
      "targetSpawn": "from_hallway",
      "text": "A narrow service door under the lamp. I try it because standing outside feels like volunteering."
    },
    "#0000ff": {
      "id": "knife_alley",
      "label": "Knife Alley",
      "text": "The alley is too thin and too dark. Cold air slips out like it knows my name."
    },
    "#00ff00": {
      "id": "lit_side_door",
      "label": "Lit Side Door",
      "targetRoom": "old_kitchen",
      "targetSpawn": "from_hallway",
      "text": "The bulb over this door still burns. I do not trust it, but I trust the street less."
    },
    "#ffff00": {
      "id": "forward_block",
      "label": "Forward Block",
      "targetRoom": "downtown_swarm",
      "targetSpawn": "from_parked_car",
      "text": "Past the building fronts, downtown waits in stacked dark windows. The car is parked as high on the block as I can risk."
    },
    "#955746": {
      "id": "broken_storefront_gate",
      "label": "Broken Gate",
      "text": "The storefront gate has folded in on itself. Capital really does leave beautiful ruins when it panics."
    },
    "#00ffff": {
      "id": "cross_street_path",
      "label": "Cross Street",
      "targetRoom": "downtown_swarm",
      "targetSpawn": "from_parked_car",
      "text": "This path cuts deeper into the block. The rain has made a mirror out of every trap."
    },
    "#808080": {
      "id": "upper_windows",
      "label": "Upper Windows",
      "text": "Far windows burn weakly above me. Light without people is worse than darkness."
    },
    "#ff8800": {
      "id": "rain_blacktop",
      "label": "Wet Road",
      "text": "Rain sits in the road in black, shallow mirrors. Every reflection looks like movement."
    }
  },
  "npcAnimations": {
    "idle": "Animation/idle.fbx",
    "walk": "Animation/walk.fbx"
  }

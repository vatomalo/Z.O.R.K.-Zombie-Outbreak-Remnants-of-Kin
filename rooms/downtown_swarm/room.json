    {
      "id": "back_to_parked_car",
      "label": "Back to Car",
      "rect": [0, 705, 190, 236],
      "targetRoom": "street_to_downtown",
      "targetSpawn": "from_street",
      "text": "I back toward the parked car. The swarm is bad math, and I am not dying for arithmetic."
    },
    {
      "id": "emergency_shop_door",
      "label": "Emergency Shop Door",
      "rect": [575, 430, 220, 295],
      "targetRoom": "old_kitchen",
      "targetSpawn": "from_hallway",
      "text": "The emergency door gives in. I step inside because the street has started counting bodies."
    }
  ],
  "hotspots": [
    {
      "id": "swarm_street",
      "label": "Swarm Street",
      "rect": [780, 420, 355, 275],
      "text": "The street fills by inches. First one shape. Then another. Then the math gets ugly."
    },
    {
      "id": "emergency_shop_door_hotspot",
      "label": "Emergency Shop Door",
      "rect": [575, 430, 220, 295],
      "targetRoom": "old_kitchen",
      "targetSpawn": "from_hallway",
      "text": "There is a door under the lamp. The handle moves. I do not ask why."
    }
  ],
  "onEnter": [
    {
      "once": "downtown_swarm.first_enter",
      "setThreat": "danger",
      "text": "The block answers all at once. Doors, alleys, windows. Too many feet in the rain."
    }
  ],
  "interests": {
    "#ffff00": {
      "id": "crowd_pressure",
      "label": "Crowd Pressure",
      "text": "The dead are not running. They do not need to. Time is doing the work for them."
    },
    "#ff8800": {
      "id": "rain_wake",
      "label": "Rain Wake",
      "text": "Rain breaks around my shoes. Behind me, the crowd keeps stitching itself together."
    },
    "#ff0000": {
      "id": "emergency_shop_door",
      "label": "Emergency Door",
      "targetRoom": "old_kitchen",
      "targetSpawn": "from_hallway",
      "text": "The emergency door is ugly, metal, and possibly useful. That is enough for me."
    },
    "#00ff00": {
      "id": "lit_escape_door",
      "label": "Lit Escape Door",
      "targetRoom": "old_kitchen",
      "targetSpawn": "from_hallway",
      "text": "The lamp above this door flickers like it is trying to warn me in Morse code. I never learned Morse."
    },
    "#0000ff": {
      "id": "mouth_alley",
      "label": "Mouth Alley",
      "text": "The alley opens like a mouth. No, thank you. I already have enough teeth in my night."
    },
    "#00ffff": {
      "id": "parked_car_upper",
      "label": "Parked Car",
      "text": "The car is parked high on the block, as far from the lower crowd as I could force it."
    },
    "#808080": {
      "id": "blind_windows",
      "label": "Blind Windows",
      "text": "The windows stare without helping. Typical architecture."
    },
    "#955746": {
      "id": "folded_gate",
      "label": "Folded Gate",
      "text": "A folded gate rattles in the rain. It sounds like coins in a dead pocket."
    }
  },
